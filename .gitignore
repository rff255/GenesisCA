# Dependencies
node_modules/

# Build output
dist/
# vite-plugin-pwa dev service-worker output (regenerated each `npm run dev`)
dev-dist/

# Vite
.vite/

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Claude Code config: keep local settings out of git, but DO share project
# slash commands (.claude/commands/) so the whole team gets them.
.claude/*
!.claude/commands/

# Auto-generated library index (created by Vite plugin at dev/build time)
public/models/index.json

# Auto-extracted thumbnail sidecars (regenerated from each .gcaproj's
# `properties.thumbnail` on every dev start / build)
public/models/*.thumb.png
public/models/*.thumb.jpg
public/models/*.thumb.jpeg
public/models/*.thumb.gif
public/models/*.thumb.webp

# Bond-Graph Agents dev test fixtures
public/agents-test.gcaproj
public/agents-*.gcaproj

# esbuild temp bundle entries written by the DEV check scripts
scripts/__*_entry.ts

# Presentation viewer build artifacts
dist-viewer/
public/viewer-template.html

# GRA milestone orchestration baselines (local only)
.gra-baseline/
