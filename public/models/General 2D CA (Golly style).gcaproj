{"schemaVersion":2,"properties":{"name":"General 2D CA (Golly style)","author":"","modelAuthor":"Rodrigo F. Figueiredo","description":"A generalized Life-like (Born/Survive) 2D CA in the Golly style. A single Lookup Table with CUSTOM row/column labels (neighbour count 0-8 x Born/Survive) and a BINARY value type encodes any B/S rule as an on/off table — no internal helper attributes, no decimal placeholders. Ships 12 classic rules as presets (Conway Game of Life, Replicator/HighLife, Diamoeba, Anneal, Morley, Coral, Seeds-like, …); switch between them live.","topology":"2d-grid","boundaryTreatment":"torus","updateMode":"synchronous","asyncScheme":"random-order","gridWidth":100,"gridHeight":100,"gridDepth":1,"maxIterations":1000,"tags":["golly","born-survive","life-like","generalized","lookup-table","conway"],"useWasm":true,"dimension":"2d","useWebGPU":false,"endConditions":{"enabled":false,"maxGenerations":32},"ruleAuthor":"Various (Life-like CA rulespace)","projectAuthor":"Rodrigo F. Figueiredo"},"attributes":[{"id":"new_attribute_mqlri20ztye","name":"Alive","type":"bool","description":"","isModelAttribute":false,"defaultValue":"false"},{"id":"new_attribute_mr6qmj5phh4","name":"Reset Alive Distribution","type":"float","description":"","isModelAttribute":true,"defaultValue":"0.5","hasBounds":true,"min":0,"max":1},{"id":"new_attribute_mqluf13kur2","name":"Born/Survive Rule","type":"lookupTable","description":"","isModelAttribute":true,"defaultValue":"","rowKeySource":{"kind":"custom","labels":["0","1","2","3","4","5","6","7","8"]},"colKeySource":{"kind":"custom","labels":["Born","Survive"]},"tableValues":{"0":{"Survive":1},"2":{"Born":0,"Survive":0},"3":{"Born":1,"Survive":1},"4":{"Survive":1,"Born":1},"5":{"Survive":1},"6":{"Survive":1},"7":{"Survive":0},"8":{"Survive":0}},"valueType":"bool"},{"id":"new_attribute_mr6qzivmynn","name":"Age","type":"integer","description":"","isModelAttribute":false,"defaultValue":"1","parentAttributeId":"new_attribute_mqlri20ztye","par