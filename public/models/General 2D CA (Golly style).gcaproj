ndaries. First studied by Dean Hickerson, who in 1993 offered a $50 prize to find a pattern that fills space with live cells; the prize was won in 1999 by David Bell."},{"id":"preset_mqn353d7zj3","name":"Anneal","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.5,"new_attribute_mqluf13kur2":0,"new_attribute_mqluheayws7":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactionTables":{"new_attribute_mqluf13kur2":{"2":{"Born":0,"Survive":0},"3":{"Born":0,"Survive":1},"4":{"Born":1,"Survive":0},"5":{"Survive":1},"6":{"Born":1,"Survive":1},"7":{"Born":1,"Survive":1},"8":{"Born":1,"Survive":1}}}},"createdAt":1782003949387,"description":"Also called the twisted majority rule. Symmetric under on-off reversal. Approximates the curve-shortening flow on the boundaries between live and dead cells."},{"id":"preset_mr6rakh22iy","name":"Empty","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.5,"new_attribute_mqluf13kur2":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactionTables":{"new_attribute_mqluf13kur2":{"2":{"Born":0,"Survive":0},"3":{"Born":0,"Survive":0}}}},"createdAt":1783193372966},{"id":"preset_mr6thg7tki5","name":"Life without Death","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.015,"new_attribute_mqluf13kur2":0,"new_attribute_mqluheayws7":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactionTables":{"new_attribute_mqluf13kur2":{"0":{"Survive":1},"1":{"Survive":1},"2":{"Born":0,"Survive":1},"3":{"Born":1,"Survive":1},"4":{"Survive":1},"5":{"Survive":1},"6":{"Survive":1},"7":{"Survive":1},"8":{"Survive":1}}}},"createdAt":1783197053273,"description":"Also known as Inkspot or Flakes. Cells that become alive never die. It combines chaotic growth with more structured ladder-like patterns that can be used to simulate arbitrary Boolean circuits."},{"id":"preset_mr6tjf0gn7b","name":"34 Life","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.1,"new_attribute_mqluf13kur2":0,"new_attribute_mqluheayws7":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactionTables":{"new_attribute_mqluf13kur2":{"2":{"Born":0,"Survive":0},"3":{"Born":1,"Survive":1},"4":{"Born":1,"Survive":1}}}},"createdAt":1783197145024,"description":"Was initially thought to be a stable alternative to Life, until computer simulation found that larger patterns tend to explode. Has many small oscillators and spaceships."},{"id":"preset_mr6tmyn8lrg","name":"Morley","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.16,"new_attribute_mqluf13kur2":0,"new_attribute_mqluheayws7":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactionTables":{"new_attribute_mqluf13kur2":{"2":{"Born":0,"Survive":1},"3":{"Born":1,"Survive":0},"4":{"Survive":1},"5":{"Survive":1},"6":{"Born":1},"8":{"Born":1}}},"width":100,"height":100,"depth":1,"attributes":{"new_attribute_mqlri20ztye":{"type":"uint8","data":""},"new_attribute_mr6qzivmynn":{"type":"int32","data":""}},"colors":""},"createdAt":1783197310436,"description":"Named after Stephen Morley; also called Move. Supports very high-period and slow spaceships."},{"id":"preset_mr6tzteeyzr","name":"Game of Life","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.1,"new_attribute_mqluf13kur2":0,"new_attribute_mqluheayws7":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactionTables":{"new_attribute_mqluf13kur2":{"2":{"Born":0,"Survive":1},"3":{"Born":1,"Survive":1},"4":{"Born":0,"Survive":0}}}},"createdAt":1783197910166,"description":"The classic Conway's Game of Life"},{"id":"preset_mr6ue88dvzj","name":"FuzzyChord Oscillators","state":{"schemaVersion":2,"modelAttrs":{"new_attribute_mr6qmj5phh4":0.16,"new_attribute_mqluf13kur2":0},"boundaryTreatment":"torus","gridWidth":100,"gridHeight":100,"gridDepth":1,"interactio