{
  "schemaVersion": 2,
  "properties": {
    "createdDate": "2026-07-05",
    "name": "General 2D CA (Golly style)",
    "author": "",
    "modelAuthor": "Rodrigo F. Figueiredo",
    "description": "A generalized Life-like (Born/Survive) 2D CA in the Golly style. A single Lookup Table with CUSTOM row/column labels (neighbour count 0-8 x Born/Survive) and a BINARY value type encodes any B/S rule as an on/off table — no internal helper attributes, no decimal placeholders. Ships 12 classic rules as presets (Conway Game of Life, Replicator/HighLife, Diamoeba, Anneal, Morley, Coral, Seeds-like, …); switch between them live.",
    "topology": "2d-grid",
    "boundaryTreatment": "torus",
    "updateMode": "synchronous",
    "asyncScheme": "random-order",
    "gridWidth": 100,
    "gridHeight": 100,
    "gridDepth": 1,
    "maxIterations": 1000,
    "tags": [
      "golly",
      "born-survive",
      "life-like",
      "generalized",
      "lookup-table",
      "conway"
    ],
    "useWasm": false,
    "dimension": "2d",
    "useWebGPU": true,
    "endConditions": {
      "enabled": false,
      "maxGenerations": 32
    },
    "ruleAuthor": "Various (Life-like CA rulespace)",
    "projectAuthor": "Rodrigo F. Figueiredo",
    "thumbnail": "data:image/gif;base64,"
  },
