{
  "schemaVersion": 1,
  "properties": {
    "name": "Morphogenesis — 3D Tissue",
    "description": "Developmental tissue in a 3D volume: asymmetric division (self-renewal + differentiation), contact inhibition, and a colour-coded maturity gradient — a self-limiting 3D tissue dividing along its mechanical (tension) axis.",
    "ruleDescription": "The 3D analog of Differential Tissue. Each cell has a maturity (lineage depth). Division is asymmetric (Division Event): daughter 0 keeps the mother maturity (self-renewal), daughter 1 advances. A cell divides only while grown, uncrowded (Neighbour Density cap — contact inhibition) and uncommitted (maturity < 5). Cells divide along the engine 3×3 tension-axis eigensolve, growing a connected 3D tissue. Colour = maturity stage.",
    "author": "",
    "projectAuthor": "",
    "tags": [
      "agents",
      "morphogenesis",
      "3d",
      "differentiation",
      "stem cells",
      "tissue"
    ],
    "dimension": "3d",
    "gridWidth": 200,
    "gridHeight": 200,
    "gridDepth": 200,
    "topology": "2d-grid",
    "boundaryTreatment": "constant",
    "useWasm": false,
    "useWebGPU": false,
    "updateMode": "synchronous",
    "asyncScheme": "random-order",
    "modelAuthor": "",
    "engine": "js",
    "reproducibility": "exact",
    "instructions": "Just reset and hit play. I recommend testing with and without the \"Metaballs\" visualization on the right side, for a more organic representation of the model.",
    "endConditions": {
      "enabled": true,
      "maxGenerations": 800
    },
    "thumbnail": "data:image/gif;base64,"
  },
  "topologyMode": {
    "gridCells": false,
    "agents": true
  },
  "centerBased": {
