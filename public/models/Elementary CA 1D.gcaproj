{
  "schemaVersion": 2,
  "properties": {
    "name": "Elementary 1D CA",
    "author": "Stephen Wolfram",
    "description": "Demonstrating the simulation of any 1D Elementary CA in a 2D space in a simple manner. Use the rule you want. By default rule 30 ( 00011110 )",
    "topology": "2d-grid",
    "boundaryTreatment": "torus",
    "gridWidth": 500,
    "gridHeight": 500,
    "maxIterations": 1000,
    "tags": [
      "1d elementary",
      "classic",
      "rule 30"
    ],
    "updateMode": "synchronous",
    "asyncScheme": "random-order",
    "modelAuthor": "Rodrigo Figueiredo",
    "thumbnail": "data:image/gif;base64,",
    "useWebGPU": true,
    "useWasm": false
  },
  "attributes": [
    {
      "id": "alive",
      "name": "alive",
      "type": "bool",
      "description": "Whether the cell is alive or dead",
      "isModelAttribute": false,
      "defaultValue": "false"
    },
    {
      "id": "new_attribute_4",
      "name": "Random Paint Probability",
      "type": "float",
      "description": "",
      "isModelAttribute": true,
      "defaultValue": "0.5",
      "hasBounds": true,
      "min": 0,
      "max": 1
    },
    {
      "id": "new_attribute_mo1ib4j3gdv",
      "name": "Computing Row",
      "type": "bool",
      "description": "",
      "isModelAttribute": false,
      "defaultValue": "false"
    },
    {
      "id": "new_attribute_mo1icrgjcd0",
      "name": "Case 111",
      "type": "bool",
      "description": "should case where left, current, and right are alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "false"
    },
    {
      "id": "new_attribute_mo1ie7giaxt",
      "name": "Case 110",
      "type": "bool",
      "description": "should case where left, and current are alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "true"
    },
    {
      "id": "new_attribute_mo1iedl3wwy",
      "name": "Case 101",
      "type": "bool",
      "description": "should case where left, and right are alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "true"
    },
    {
      "id": "new_attribute_mo1iefwem9s",
      "name": "Case 100",
      "type": "bool",
      "description": "should case where left only are alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "false"
    },
    {
      "id": "new_attribute_mo1ieh4xnqw",
      "name": "Case 011",
      "type": "bool",
      "description": "should case where current, and right are alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "true"
    },
    {
      "id": "new_attribute_mo1iei9di1o",
      "name": "Case 010",
      "type": "bool",
      "description": "should case where only current is alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "true"
    },
    {
      "id": "new_attribute_mo1iekha1io",
      "name": "Case 001",
      "type": "bool",
      "description": "should case where only right are alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "true"
    },
    {
      "id": "new_attribute_mo1if9vff5b",
      "name": "Case 000",
      "type": "bool",
      "description": "should case where no one is alive result in alive or dead?",
      "isModelAttribute": true,
      "defaultValue": "false"
    }
  ],
  "neighborhoods": [
    {
      "id": "moore",
      "name": "1D Elementary CA Case",
      "description": "Simulating a 1D CA evolving by checking the previous row",
      "coords": [[0,-1], [0,1], [1,0]],
      "margin": 2,
      "tags": {
        "0": "Left",
        "1": "Right",
        "2": "Below"
      },
      "includeCentralCell": true
    }
  ],
  "mappings": [
    {
      "id": "new_mapping_mo1i175y8e4",
      "name": "Default",
      "description": "",
      "isAttributeToColor": true,
      "redDescription": "",
      "greenDescription": "",
      "blueDescription": ""
    },
    {
      "id": "paint",
      "name": "Set Alive",
      "description": "Allows painting alive cells on the grid",
      "isAttributeToColor": false,
      "redDescription": "",
      "greenDescription": "",
      "blueDescription": ""
    },
    {
      "id": "new_mapping_mo1jl742sio",
      "name": "Set Dead",
      "description": "",
      "isAttributeToColor": false,
      "redDescription": "",
      "greenDescription": "",
      "blueDescription": ""
    },
    {
      "id": "new_mapping_2",
      "name": "Random",
      "description": "random",
      "isAttributeToColor": false,
      "redDescription": "",
      "greenDescription": "",
      "blueDescription": ""
    }
  ],
