    {"id":"nmp5v1trjoon5","type":"caNode","position":{"x":460,"y":990},"data":{"nodeType":"expression","config":{"expression":"0.2*orthoSum + 0.05*diagSum - u","visibleCount":3,"_varName_a":"orthoSum","_varName_b":"diagSum","_varName_c":"u"},"label":"U diffusion (∇²U)"}},
    {"id":"nmp5v1trjnzzv","type":"caNode","position":{"x":460,"y":1170},"data":{"nodeType":"expression","config":{"expression":"0.2*orthoSum + 0.05*diagSum - v","visibleCount":3,"_varName_a":"orthoSum","_varName_b":"diagSum","_varName_c":"v"},"label":"V diffusion (∇²V)"}},
    {"id":"nmp5v1trj2gt9","type":"caNode","position":{"x":460,"y":180},"data":{"nodeType":"expression","config":{"expression":"u * (v * v)","visibleCount":2,"_varName_a":"u","_varName_b":"v"},"label":"Reaction (U·V²)"}},
    {"id":"nmp5v1trjrf89","type":"caNode","position":{"x":690,"y":360},"data":{"nodeType":"expression","config":{"expression":"u + (Du*lapU - uvv + F*(1 - u)) * dt","visibleCount":6,"_varName_a":"u","_varName_b":"Du","_varName_c":"lapU","_varName_d":"uvv","_varName_e":"F","_varName_f":"dt"},"label":"U update (U′)"}},
