    {
      "id": "nmt71wqt8hwnk",
      "type": "caNode",
      "position": {
        "x": 460,
        "y": 990
      },
      "data": {
        "nodeType": "expression",
        "config": {
          "expression": "0.2*orthoSum + 0.05*diagSum - u",
          "visibleCount": 3,
          "_varName_a": "orthoSum",
          "_varName_b": "diagSum",
          "_varName_c": "u"
        },
        "label": "U diffusion (∇²U)"
      }
    },
    {
      "id": "nmt71wqt8ip58",
      "type": "caNode",
      "position": {
        "x": 460,
        "y": 1170
      },
      "data": {
        "nodeType": "expression",
        "config": {
          "expression": "0.2*orthoSum + 0.05*diagSum - v",
          "visibleCount": 3,
          "_varName_a": "orthoSum",
          "_varName_b": "diagSum",
          "_varName_c": "v"
        },
        "label": "V diffusion (∇²V)"
      }
    },
    {
      "id": "nmt71wqt9o1cn",
      "type": "caNode",
      "position": {
        "x": 460,
        "y": 180
      },
      "data": {
        "nodeType": "expression",
        "config": {
          "expression": "u * (v * v)",
          "visibleCount": 2,
          "_varName_a": "u",
          "_varName_b": "v"
        },
        "label": "Reaction (U·V²)"
      }
    },
    {
      "id": "nmt71wqt9ozzk",
      "type": "caNode",
      "position": {
        "x": 690,
        "y": 360
      },
      "data": {
        "nodeType": "expression",
        "config": {
          "expression": "u + (Du*lapU - uvv + F*(1 - u)) * dt",
          "visibleCount": 6,
          "_varName_a": "u",
          "_varName_b": "Du",
          "_varName_c": "lapU",
          "_varName_d": "uvv",
          "_varName_e": "F",
          "_varName_f": "dt"
        },
        "label": "U update (U′)"
      }
    },
    {
      "id": "nmt71wqt91nif",
      "type": "caNode",
      "position": {
        "x": 690,
        "y": 810
      },
      "data": {
        "nodeType": "expression",
        "config": {
          "expression": "v + (Dv*lapV + uvv - (F + k)*v) * dt",
          "visibleCount": 7,
          "_varName_a": "v",
          "_varName_b": "Dv",
          "_varName_c": "lapV",
          "_varName_d": "uvv",
          "_varName_e": "F",
          "_varName_f": "k",
          "_varName_g": "dt"
        },
        "label": "V update (V′)"
      }
    },
