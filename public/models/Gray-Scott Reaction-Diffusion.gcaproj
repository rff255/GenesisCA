    {
      "id": "presetmp5coblbsqc1",
      "name": "Spots",
      "description": "Stable isolated spots on a uniform background.",
      "state": {
        "schemaVersion": 2,
        "modelAttrs": {
          "F": 0.03,
          "k": 0.062,
          "Du": 1,
          "Dv": 0.5,
          "dt": 1
        }
