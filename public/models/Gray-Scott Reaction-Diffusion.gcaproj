    },
    {
      "id": "presetmp5coblbh49i",
      "name": "Mitosis",
      "description": "Spots that grow and split, endlessly dividing like cells.",
      "state": {
        "schemaVersion": 2,
        "modelAttrs": {
          "F": 0.0367,
