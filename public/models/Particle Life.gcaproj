{
  "schemaVersion": 1,
  "properties": {
    "name": "Particle Life",
    "description": "The classic Particle Life sandbox: K species, a signed attraction/repulsion matrix, per-pair min/max radii — chase spirals, membranes and cell-like blobs emerge from one table.",
    "ruleDescription": "Each particle sums a pairwise force over neighbours within queryRadius: below the pair’s attractMin the force is always repulsive (repel·(d/minR−1)); between attractMin and attractMax it follows a tent peaking at the midpoint with height rules[my][their] ∈ [−1,1]. Velocity keeps friction·v each step (graph-side Set Velocity; engine momentum 1). All three tables are live — edit them (or Randomize with a signed range) while playing. rules is ASYMMETRIC: A may chase B while B flees A, which is where the endless pursuit dynamics come from. Presets carry named matrices (snake / rock–paper–scissors / symmetric clusters). N applies on Reset.",
    "author": "",
    "projectAuthor": "",
    "tags": [
      "agents",
      "particle-life",
      "emergence",
      "matrix"
    ],
    "dimension": "2d",
    "gridWidth": 320,
    "gridHeight": 200,
    "gridDepth": 1,
    "topology": "2d-grid",
    "boundaryTreatment": "torus",
    "useWasm": false,
    "useWebGPU": false
  },
  "topologyMode": {
    "gridCells": false,
    "agents": true
  },
  "centerBased": {
    "enabled": true,
    "maxAgents": 3200,
    "maxBonds": 0,
    "worldWidth": 320,
    "worldHeight": 200,
    "repulsionStiffness": 0,
    "adhesionStiffness": 0,
    "interactionRange": 1.5,
    "drag": 1,
    "timeStep": 1,
    "momentum": 1,
    "maxSpeed": 0,
    "neighbourQueryRadius": 24,
    "useBondingPhysics": false,
    "autoBond": false,
    "growthRate": 0,
    "bondStiffness": 0,
    "seedCount": 0,
    "seedPattern": "scatter",
    "defaultRadius": 1.2,
    "agentTarget": "wasm",
    "agentUpdateMode": "async",
    "agentCapabilities": {
      "motion": "force",
      "body": true,
      "collision": "off",
      "bonds": "off",
      "autoBond": false,
      "growth": false,
      "division": false,
      "lifespan": false,
      "populationBirth": true,
      "populationDeath": true,
      "sensing": true,
      "sensingHeadingSource": "velocity",
      "orientation": false,
      "fieldCoupling": false,
      "appearance": true
    }
  },
  "attributes": [
    {
      "id": "numParticles",
      "name": "N (particles)",
      "description": "Population size — applied on Reset (the Agent Init spawn loop reads it).",
      "type": "integer",
      "isModelAttribute": true,
      "defaultValue": "1800",
      "hasBounds": true,
      "min": 100,
      "max": 3200
    },
    {
      "id": "forceFactor",
      "name": "forceFactor",
      "description": "Overall force gain.",
      "type": "float",
      "isModelAttribute": true,
      "defaultValue": "0.05",
      "hasBounds": true,
      "min": 0.01,
      "max": 1
    },
    {
      "id": "repel",
      "name": "repel",
      "description": "Strength of the short-range repulsion core (below each pair’s min radius).",
      "type": "float",
      "isModelAttribute": true,
      "defaultValue": "1.5",
      "hasBounds": true,
      "min": 0,
      "max": 3
    },
    {
      "id": "friction",
      "name": "friction",
      "description": "Velocity keep-fraction per step (1 = frictionless, 0 = full stop).",
      "type": "float",
      "isModelAttribute": true,
      "defaultValue": "0.8",
      "hasBounds": true,
      "min": 0,
      "max": 0.99
    },
    {
      "id": "queryRadius",
      "name": "queryRadius",
      "description": "Neighbour search radius. Keep ≥ the attractMax range and ≤ 24 (the spatial-hash ceiling) or far pairs stop interacting.",
      "type": "float",
      "isModelAttribute": true,
      "defaultValue": "16",
      "hasBounds": true,
      "min": 4,
      "max": 24
    },
    {
      "id": "rules",
      "name": "rules",
      "description": "Attraction (+) / repulsion (−) per species pair — THE Particle Life matrix. Asymmetric: rules[A][B] is the force ON an A FROM a B.",
      "type": "lookupTable",
      "isModelAttribute": true,
      "defaultValue": "0",
      "rowKeySource": {
        "kind": "tagAttribute",
        "attributeId": "species"
      },
      "colKeySource": {
        "kind": "tagAttribute",
        "attributeId": "species"
