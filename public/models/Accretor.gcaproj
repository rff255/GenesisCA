{
  "schemaVersion": 2,
  "properties": {
    "name": "Accretor",
    "author": "Erwin Driessens & Maria Verstappen (Accretor); via Softology (2018)",
    "modelAuthor": "Rodrigo F. Figueiredo",
    "description": "A 3D accretion automaton (Driessens & Verstappen) that grows based on a randomly generated rule table that is a twist on the usual outer totalist CA: by separating the number of alive cells in three neighborhoods: faces, edges, and corners. This gives rise to many hundreds of thousand possible rules.",
    "topology": "2d-grid",
    "boundaryTreatment": "constant",
    "updateMode": "synchronous",
    "asyncScheme": "random-order",
    "gridWidth": 300,
    "gridHeight": 300,
    "gridDepth": 300,
    "dimension": "3d",
    "maxIterations": 100000,
    "tags": [
      "accretion",
      "growth",
      "rule-table",
      "Driessens-Verstappen"
    ],
    "useWasm": false,
    "skipIsolatedEmpty": {
      "enabled": false,
      "emptyAttributeId": "state",
      "emptyValue": "0",
      "rangeKind": "radius",
      "radius": 1,
      "radiusMetric": "chebyshev",
      "neighborhoodId": "faces"
    },
    "endConditions": {
      "enabled": true,
      "maxGenerations": 1000
    },
    "ruleDescription": "Empty cells crystallise into A or B according to a RANDOMLY-FILLED rule table indexed by how many of their 6 face, 12 edge, and 8 corner neighbours are occupied. Occupied cells freeze forever. From a small central seed the structure accretes outward until max generations reached. The 300×300×300 volume (27M cells) ships on the WebGPU compile target, which dispatches every cell in parallel — measured as the better choice for this model, and increasingly so as the structure grows or at more than one generation per frame. On the CPU targets (WebAssembly / JS) turn on 'Skip Isolated Empty Cells' (Properties ▸ Execution) instead: it runs only the cells near the growing surface (the config is already filled in, just tick it). Toggle the `Symmetric seed` model attribute + Reset to grow a mirror-symmetric structure instead of a random one. The rule is one 3-axis (face × edge × corner count) Lookup Table filled by a seed — re-roll the seed in the table's Randomize block (Attributes ▸ rule) to grow an entirely different form. Orbit the camera and pull the clip plane to see inside.",
    "thumbnail": "data:image/gif;base64,",
    "useWebGPU": true
  },
  "attributes": [
    {
      "id": "state",
      "name": "State",
      "type": "tag",
      "description": "The cell's crystallised state: empty (0, still growable), or one of the accreted species A / B (frozen once set).",
      "isModelAttribute": false,
      "defaultValue": "0",
      "boundaryValue": "0",
      "tagOptions": [
        "empty",
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    {
      "id": "symmetricSeed",
      "name": "Symmetric seed",
      "type": "bool",
      "description": "When ON, the central seed is mirror-symmetric (concentric shells) so the structure grows symmetric; when OFF, the seed is a uniform random asymmetric block. Toggle it and press Reset to compare. (Softology: \"symmetric seeds produce symmetric structures\".)",
      "isModelAttribute": true,
      "defaultValue": "false"
    },
    {
      "id": "new_attribute_mrn6f31fikk",
      "name": "Boundary",
      "type": "bool",
      "description": "",
      "isModelAttribute": false,
      "defaultValue": "false",
      "boundaryValue": "true"
    },
    {
      "id": "new_attribute_mrpctix5864",
      "name": "#Cell States",
      "type": "integer",
      "description": "(including empty) If you change this, change the 'max' when randomizing the rule table to be #Cell_States-1",
      "isModelAttribute": true,
      "defaultValue": "3",
      "hasBounds": true,
      "min": 2,
      "max": 6
    },
    {
      "id": "rule_copy_mrpcudutsq6",
      "name": "Rule Table",
      "type": "lookupTable",
      "description": "The accretion rule: newState = rule[state, faceCount, edgeCount, cornerCount]. A 4-axis table (3 states × 0..6 faces × 0..12 edges × 0..8 corners = 2457 entries) filled randomly at ~20% density — the SEED is the rule identity. Only the state=0 slice is consulted (empty cells accrete); re-roll the seed in the Randomize block to grow a different structure.",
      "isModelAttribute": true,
      "defaultValue": "0",
      "axes": [
        {
          "name": "Faces",
          "source": {
            "kind": "intRange",
            "min": 0,
            "max": 6
          }
        },
        {
          "name": "Edges",
          "source": {
            "kind": "intRange",
            "min": 0,
            "max": 12
          }
        },
        {
          "name": "Corners",
          "source": {
            "kind": "intRange",
            "min": 0,
            "max": 8
          }
        }
      ],
      "valueType": "integer",
      "valueTagAttributeId": "state",
      "tableData": [
