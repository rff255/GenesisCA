{
  "schemaVersion": 2,
  "properties": {
    "name": "Kelp War",
    "author": "Rodrigo F. Figueiredo",
    "modelAuthor": "Rodrigo F. Figueiredo",
    "description": "Exploration of biological systems of competition while the population of both species self-regulate into equilibrium. The idea was to explore systems that would naturally emerge the behavior of being in perpetual back and forth of competition without reaching an end. There is no global \"spawn\" or mercy rules to artificially control the environment.",
    "topology": "2d-grid",
    "boundaryTreatment": "torus",
    "updateMode": "synchronous",
    "asyncScheme": "random-order",
    "gridWidth": 300,
    "gridHeight": 300,
    "maxIterations": 1000,
    "tags": [
      "5-state",
      "outer-totalistic",
      "non-deterministic",
      "predator-prey-like"
    ],
    "useWasm": false,
    "useWebGPU": false,
    "thumbnail": "data:image/gif;base64,"
  },
