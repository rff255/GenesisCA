    {
      "id": "paintFire",
      "name": "Fire brush",
      "isAttributeToColor": false,
      "description": "Paint a fire state onto the landscape. Cells whose fuel cannot burn (water, bare rock) are left alone.",
      "redDescription": "",
      "greenDescription": "",
      "blueDescription": "",
      "parameters": [
        {
          "key": "st",
          "name": "Paint state",
          "type": "tag",
