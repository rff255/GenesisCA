{
  "schemaVersion": 1,
  "properties": {
    "name": "Agent WASM Drift Test",
    "description": "Minimal deterministic agents (spring toward centre) — the JS↔WASM agent-loop bit-parity vehicle for PR6b-1.",
    "ruleDescription": "Each agent reads its own position, computes a centre-pulling force ((centre − pos)·k), and applies it. No RNG, no neighbours, no bonds — fully deterministic, so JS and WASM agent loops must be bit-identical.",
    "author": "",
    "projectAuthor": "",
    "tags": [
      "agents",
      "wasm",
      "test",
      "parity"
    ],
    "dimension": "2d",
    "gridWidth": 60,
    "gridHeight": 60,
    "gridDepth": 1,
    "topology": "2d-grid",
    "boundaryTreatment": "constant",
    "useWasm": false,
    "useWebGPU": false
  },
  "topologyMode": {
    "gridCells": true,
    "agents": true
  },
  "centerBased": {
    "enabled": true,
    "maxAgents": 64,
    "maxBonds": 2,
    "worldWidth": 60,
    "worldHeight": 60,
    "seedCount": 16,
    "seedPattern": "compact",
    "defaultRadius": 0.5,
    "growthRate": 0,
    "repulsionStiffness": 2,
    "adhesionStiffness": 0,
    "interactionRange": 1.5,
    "drag": 1,
    "timeStep": 0.1,
    "momentum": 0,
    "maxSpeed": 0,
    "neighbourQueryRadius": 5,
    "customForcesOnly": false,
    "autoBond": false,
    "bondStiffness": 1,
    "bondRestLength": 1,
    "formDistance": 1.1,
    "breakDistance": 1.6,
    "agentTarget": "wasm"
  },
