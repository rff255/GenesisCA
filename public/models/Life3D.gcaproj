{
  "schemaVersion": 2,
  "properties": {
    "name": "Life3D",
    "author": "Carter Bays (3D Life rule 5766)",
    "modelAuthor": "Rodrigo F. Figueiredo",
    "description": "3D Game of Life on a 24x24x24 torus, Carter Bays' classic 5766 rule: a live cell survives with 5-7 live neighbours (of 26), a dead cell is born with exactly 6. Reset seeds a randomized slab of central layers, then press Play to watch structures bloom and dissolve through the volume. Orbit the camera and pull the clip plane to see inside.",
    "topology": "2d-grid",
    "boundaryTreatment": "torus",
    "updateMode": "synchronous",
    "asyncScheme": "random-order",
    "gridWidth": 24,
    "gridHeight": 24,
    "gridDepth": 24,
    "dimension": "3d",
    "maxIterations": 100000,
    "tags": [
      "3D",
      "Life",
      "totalistic",
      "Bays",
      "voxel"
    ],
    "useWasm": true
  },
  "attributes": [
    {
      "id": "alive",
      "name": "Alive",
      "type": "bool",
      "description": "Whether the cell is alive (1) or dead (0).",
      "isModelAttribute": false,
      "defaultValue": "false"
    }
  ],
