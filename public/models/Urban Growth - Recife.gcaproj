      "data": {
        "nodeType": "expression",
        "config": {
          "expression": "(nUrban + rw * 0.25 * nRoad) / 8",
          "visibleCount": 3,
          "_varName_a": "nUrban",
          "_varName_b": "rw",
          "_varName_c": "nRoad"
        },
