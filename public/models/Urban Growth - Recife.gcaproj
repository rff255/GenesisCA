          "_varName_a": "base",
          "_varName_b": "suit",
          "_varName_c": "edge",
          "_varName_d": "rw",
          "_varName_e": "rd",
          "_varName_f": "rr",
          "_varName_g": "sr",
          "_varName_h": "slope"
        },
        "label": "P(urbanise this step)"
