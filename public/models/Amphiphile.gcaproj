  "presets": [
    {
      "id": "preset_mpc26p8ha8ne",
      "name": "Book — Example 5.3 defaults",
      "description": "Kier, Seybold & Cheng (2005), Example 5.3 page 86 — the parameter set the book uses for its micelle-formation demonstration. Produces moderate micelles. NOT identical to any paper Table I set: notably J(W-W) = 1.70 (paper uses 1.0) and J(W-Y) = 2.0 / P_B(W-Y) = 0.20 (very polar head — the paper notes a *modestly* polar head gives larger micelles, so this is intentionally a sub-optimal demo).",
      "state": {
        "schemaVersion": 2,
        "interactionTables": {
          "tableP_B": {
            "none": {
              "none": 1,
