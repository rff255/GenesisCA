    "maxAgents": 5000,
    "maxBonds": 8,
    "worldWidth": 100,
    "worldHeight": 100,
    "seedCount": 220,
    "seedPattern": "scatter",
    "defaultRadius": 1,
    "growthRate": 0,
    "repulsionStiffness": 10,
    "adhesionStiffness": 0,
    "interactionRange": 10,
